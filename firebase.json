{
    "hosting": {
        "site": "openbiin",
        "public": "dist",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "/api/**",
                "function": "api_handler"
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    },
    "functions": {
        "source": "functions"
    },
    "emulators": {
        "functions": {
            "port": 6381
        },
        "ui": {
            "enabled": true
        },
        "singleProjectMode": true
    }
}